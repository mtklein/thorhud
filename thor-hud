class Power:
    """org.armada.Power proxy (profile, governor, GPU level/clock)."""

    IFACE = "org.armada.Power1"

    def __init__(self, on_change):
        self.proxy = None
        try:
            self.proxy = Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
                "org.armada.Power", "/org/armada/Power", self.IFACE, None)
            self.proxy.connect("g-properties-changed", lambda *_: on_change())
        except GLib.Error as e:
            print("thor-hud: power service unavailable:", e.message, file=sys.stderr)

    def get(self, name, default=None):
        if not self.proxy:
            return default
        v = self.proxy.get_cached_property(name)
        return v.unpack() if v is not None else default

    def set(self, name, variant):
        if not self.proxy:
            return
        self.proxy.call(
            "org.freedesktop.DBus.Properties.Set",
            GLib.Variant("(ssv)", (self.IFACE, name, variant)),
            Gio.DBusCallFlags.NONE, 3000, None, self._done, name)

    def _done(self, proxy, result, name):
        try:
            proxy.call_finish(result)
        except GLib.Error as e:
            print(f"thor-hud: set {name} failed:", e.message, file=sys.stderr)


class Segmented(Gtk.Box):
    def __init__(self, options, on_pick, css):
        super().__init__(homogeneous=True, css_classes=["seg", css])
        self.buttons = {}
        self.on_pick = on_pick
        self.syncing = False
        group = None
        for value, label in options:
            b = Gtk.ToggleButton(label=label, hexpand=True)
            if group:
                b.set_group(group)
            group = group or b
            b.connect("toggled", self.toggled, value)
            self.append(b)
            self.buttons[value] = b

    def toggled(self, button, value):
        if button.get_active() and not self.syncing:
            self.on_pick(value)

    def select(self, value):
        self.syncing = True
        for v, b in self.buttons.items():
            b.set_active(v == value)
        self.syncing = False


class Hud(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Thor HUD")
        self.sampler = Sampler()
        self.power = Power(lambda: GLib.idle_add(self.sync_knobs))
        self.gpu_freqs = sorted(int(f) // 1_000_000 for f in
                                read(f"{GPU_DEVFREQ}/available_frequencies").split()) if GPU_DEVFREQ else []

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                       margin_top=8, margin_bottom=8, margin_start=8, margin_end=8,
                       css_classes=["root"])
        self.set_child(root)

        self.fps = FpsPanel()
        self.fps.set_size_request(-1, 120)
        root.append(self.card(self.fps, vexpand=True))

        gauges = Gtk.Box(spacing=8, homogeneous=True)
        self.g_cpu = Gauge("CPU", CPU_C, 100)
        self.g_gpu = Gauge("GPU", GPU_C, 100)
        self.g_pwr = Gauge("WATTS", PWR_C, 20)
        self.g_tmp = Gauge("°C", TEMP_SCALE[0][1], 100)
        self.g_bat = Gauge("BATTERY", NEUTRAL, 100)
        for g in (self.g_cpu, self.g_gpu, self.g_pwr, self.g_tmp, self.g_bat):
            g.set_size_request(-1, 104)
            gauges.append(self.card(g))
        root.append(gauges)

        self.bars = Bars()
        self.bars.set_size_request(-1, 118)
        root.append(self.card(self.bars))

        knobs = Gtk.Grid(column_spacing=10, row_spacing=6, css_classes=["card", "knobs"])
        knobs.set_margin_top(0)
        root.append(knobs)

        profiles = self.power.get("AvailableProfiles", ["Eco", "Balanced", "Performance"])
        self.k_profile = Segmented([(p, p) for p in profiles],
                                   lambda v: self.power.set("Profile", GLib.Variant("s", v)), "profile")
        self.k_gov = Segmented([(g, {"conservative": "Conserv.", "schedutil": "Sched",
                                     "performance": "Perf"}[g]) for g in GOVERNORS],
                               lambda v: self.power.set("CpuScalingGovernor", GLib.Variant("s", v)), "gov")
        self.k_gpu_mode = Segmented([("auto", "Auto"), ("manual", "Fixed")], self.pick_gpu_mode, "gpu")
        self.k_gpu_clock = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL,
                                                    0, max(1, len(self.gpu_freqs) - 1), 1)
        self.k_gpu_clock.set_draw_value(False)
        self.k_gpu_clock.set_hexpand(True)
        self.k_gpu_clock.connect("value-changed", self.gpu_clock_moved)
        self.k_gpu_label = Gtk.Label(css_classes=["value"], width_chars=8, xalign=1)
        self.gpu_clock_timer = None
        self.syncing = False

        for row, (cap, widget) in enumerate([("PROFILE", self.k_profile), ("CPU GOV", self.k_gov)]):
            knobs.attach(Gtk.Label(label=cap, xalign=0, css_classes=["caption"]), 0, row, 1, 1)
            knobs.attach(widget, 1, row, 2, 1)
        knobs.attach(Gtk.Label(label="GPU CLK", xalign=0, css_classes=["caption"]), 0, 2, 1, 1)
        gpu_row = Gtk.Box(spacing=10)
        self.k_gpu_mode.set_size_request(130, -1)
        gpu_row.append(self.k_gpu_mode)
        gpu_row.append(self.k_gpu_clock)
        gpu_row.append(self.k_gpu_label)
        knobs.attach(gpu_row, 1, 2, 2, 1)

        self.sync_knobs()
        self.tick()
        GLib.timeout_add(500, self.fast_tick)
        GLib.timeout_add(1000, self.tick)

    def card(self, child, vexpand=False):
        frame = Gtk.Box(css_classes=["card"], vexpand=vexpand)
        frame.append(child)
        return frame

    # -- knobs
    def sync_knobs(self):
        self.syncing = True
        self.k_profile.select(self.power.get("Profile"))
        self.k_gov.select(self.power.get("CpuScalingGovernor"))
        level = self.power.get("GpuPerformanceLevel", "auto")
        self.k_gpu_mode.select(level)
        clock = self.power.get("ManualGpuClock", self.gpu_freqs[-1] if self.gpu_freqs else 0)
        if self.gpu_freqs:
            idx = min(range(len(self.gpu_freqs)), key=lambda i: abs(self.gpu_freqs[i] - clock))
            self.k_gpu_clock.set_value(idx)
        self.k_gpu_clock.set_sensitive(level == "manual")
        self.k_gpu_label.set_label(f"{clock} MHz" if level == "manual" else "auto")
        self.syncing = False
        return False

    def pick_gpu_mode(self, mode):
        self.power.set("GpuPerformanceLevel", GLib.Variant("s", mode))

    def gpu_clock_moved(self, scale):
        if self.syncing or not self.gpu_freqs:
            return
        mhz = self.gpu_freqs[int(round(scale.get_value()))]
        self.k_gpu_label.set_label(f"{mhz} MHz")
        if self.gpu_clock_timer:
            GLib.source_remove(self.gpu_clock_timer)

        def commit():
            self.gpu_clock_timer = None
            self.power.set("ManualGpuClock", GLib.Variant("u", mhz))
            return False
        self.gpu_clock_timer = GLib.timeout_add(250, commit)

    # -- metrics
    def fast_tick(self):
        r = self.sampler.fps
        # Hold a reading until about 1.5 reporting intervals have passed.
        fresh = r.fps is not None and time.monotonic() - r.stamp < max(3, 450 / max(r.fps, 1))
        self.fps.push(r.fps if fresh else None, r.focus)
        return True

    def tick(self):
        s = self.sampler.sample()
        if s["cpu"] is not None:
            self.g_cpu.update(s["cpu"], f"{s['cpu']:.0f}%")
        gpu_sub = f"{s.get('gpu_mhz', 0)} MHz"
        if s["gpu"] is not None:
            self.g_gpu.update(s["gpu"], f"{s['gpu']:.0f}%", gpu_sub)
        charging = s["bat_status"] in ("Charging", "Full") or s["usb_w"] > 0.5
        if charging:
            self.g_pwr.update(s["usb_w"], f"{s['usb_w']:.1f}", "from USB")
        else:
            self.g_pwr.update(s["bat_w"], f"{s['bat_w']:.1f}", "draw")
        hot = max(s["cpu_temp"], s["gpu_temp"])
        fan = f"fan {s['fan_rpm']}" if s["fan_rpm"] is not None else f"bat {s['bat_temp']:.0f}°"
        tc = temp_color(hot)
        self.g_tmp.update(hot, f"{hot:.0f}", fan, tc, tc if hot >= 75 else None)
        eta = ""
        if s["bat_eta"] is not None:
            hours = s["bat_eta"]
            eta = f"{int(hours)}h{int(hours * 60) % 60:02d}" + (" to full" if charging else " left")
        elif charging:
            eta = "charging"
        low = None if charging else BAD if s["bat_pct"] <= 10 else WARN if s["bat_pct"] <= 20 else None
        self.g_bat.update(s["bat_pct"], f"{s['bat_pct']}", eta, low, low)
        rows = []
        for name, usage, cur, cap, hw in s["clusters"]:
            rows.append((name, usage / 100, cap / hw if hw else None,
                         f"{usage:3.0f}% {cur / 1000:.2f}G", CPU_C))
        if "gpu_mhz" in s and self.gpu_freqs:
            top = self.gpu_freqs[-1]
            rows.append(("GPU", s["gpu_mhz"] / top, s["gpu_max_mhz"] / top,
                         f"{s['gpu_mhz']} MHz", GPU_C))
        rows.append(("RAM", s["mem_used"] / s["mem_total"], None,
                     f"{s['mem_used']:.1f}/{s['mem_total']:.0f}G", NEUTRAL))
        self.bars.update(rows)
        return True


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.thor.Hud", flags=Gio.ApplicationFlags.NON_UNIQUE)

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        settings = Gtk.Settings.get_default()
        settings.set_property("gtk-application-prefer-dark-theme", True)
        win = Hud(self)
        if "--windowed" in sys.argv:
            win.set_default_size(620, 540)
        else:
            win.fullscreen()
        win.present()
        if "--snapshot" in sys.argv:
            GLib.timeout_add(8000, self.snapshot, win)

    def snapshot(self, win):
        paintable = Gtk.WidgetPaintable.new(win)
        w, h = win.get_width(), win.get_height()
        snap = Gtk.Snapshot()
        paintable.snapshot(snap, w, h)
        node = snap.to_node()
        renderer = win.get_native().get_renderer()
        tex = renderer.render_texture(node, None)
        tex.save_to_png(sys.argv[sys.argv.index("--snapshot") + 1])
        print(f"snapshot {w}x{h}")
        self.quit()
        return False


if __name__ == "__main__":
    sys.exit(App().run([sys.argv[0]]))
