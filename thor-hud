#!/usr/bin/python3
"""thor-hud: dark performance dashboard + quick knobs for the AYN Thor bottom screen.

Metrics: gamescope stats pipe (FPS, focused app), /proc and sysfs (CPU, GPU, power,
thermals, RAM, fan). Knobs: org.armada.Power on the system bus (profile, CPU
governor, GPU clock).
"""
import collections
import glob
import math
import os
import sys
import threading
import time

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango, PangoCairo  # noqa: E402

STATS_PIPE = f"/run/user/{os.getuid()}/gamescope-stats/stats.pipe"
GPU_DEVFREQ = next(iter(glob.glob("/sys/class/devfreq/*.gpu")), None)
BATTERY = "/sys/class/power_supply/battery"
USB = "/sys/class/power_supply/qcom-battmgr-usb"
# Each profile carries its CPU governor; the HUD reasserts it whenever the
# profile changes (from here or from Steam), since armada-powerd applies its own.
PROFILE_GOVERNOR = {"Eco": "conservative", "Balanced": "schedutil", "Performance": "performance"}
MAX_FPS = 240

# Muted palette. Category accents share OKLCH lightness 0.74 / chroma 0.06 so no
# metric outshines another; green and red are reserved for good/bad signals and
# the hot end of the temperature scale.
def hexc(h):
    return tuple(int(h[i:i + 2], 16) / 255 for i in (1, 3, 5))


TRACK = hexc("#23272a")
DIM = hexc("#82878c")
TEXT = hexc("#e5e8eb")
CPU_C = hexc("#8bafcf")     # blue
GPU_C = hexc("#ada4cd")     # violet
NEUTRAL = hexc("#9facba")   # slate (fps, ram, battery)
WARN = hexc("#dea45f")
BAD = hexc("#dd766f")
# Heat scale (cool blue → khaki → amber → red), all near the same lightness
# until hot. Used for temperature and battery draw; the number is tinted too
# once a reading reaches amber.
HEAT = [hexc("#89b0cd"), hexc("#b0ac8f"), hexc("#dea45f"), hexc("#e87a69")]


def heat_scale(cool, khaki, amber, hot):
    return list(zip((cool, khaki, amber, hot), HEAT))


# The Thor idles around 55 °C, so the temperature scale starts there.
TEMP_SCALE = heat_scale(55, 67, 77, 88)
POWER_SCALE = heat_scale(5, 6.8, 8.3, 10)  # watts drawn from the battery


def heat_color(t, scale):
    if t <= scale[0][0]:
        return scale[0][1]
    for (t0, c0), (t1, c1) in zip(scale, scale[1:]):
        if t <= t1:
            f = (t - t0) / (t1 - t0)
            return tuple(a + (b - a) * f for a, b in zip(c0, c1))
    return scale[-1][1]


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def read_int(path, default=0):
    try:
        return int(read(path))
    except ValueError:
        return default


def display_max_hz(default=120):
    """Top refresh rate of the main gamescope (the one writing the stats pipe)."""
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or not read(f"/proc/{pid}/comm").startswith("gamescope"):
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                args = f.read().decode(errors="replace").split("\0")
        except OSError:
            continue
        if "-T" in args and "--custom-refresh-rates" in args:
            rates = args[args.index("--custom-refresh-rates") + 1]
            try:
                return max(int(r) for r in rates.split(","))
            except ValueError:
                pass
    return default


STEAM = os.path.expanduser("~/.local/share/Steam")
_app_names = {}


def app_name(focus):
    """gamescope reports the focused app as "steam" or a Steam AppId; show its title."""
    if focus == "steam":
        return "Steam"
    if not focus.isdigit():
        return focus
    if focus not in _app_names:
        name = ""
        libraries = [STEAM] + [line.split('"')[3] for line in
                               read(f"{STEAM}/steamapps/libraryfolders.vdf").splitlines()
                               if line.strip().startswith('"path"')]
        for lib in libraries:
            for line in read(f"{lib}/steamapps/appmanifest_{focus}.acf").splitlines():
                parts = line.split('"')
                if len(parts) >= 4 and parts[1] == "name":
                    name = parts[3]
                    break
            if name:
                break
        _app_names[focus] = name  # Non-Steam shortcuts have no manifest; show nothing.
    return _app_names[focus]


def uevent(path):
    out = {}
    for line in read(f"{path}/uevent").splitlines():
        k, _, v = line.partition("=")
        out[k.removeprefix("POWER_SUPPLY_")] = v
    return out


# ---------------------------------------------------------------- sampling

class FpsReader(threading.Thread):
    """Reads gamescope's stats FIFO ("fps=…" / "focus=…" lines).

    gamescope writes a reading roughly every 300 frames (~10 s at 30 fps, ~2.5 s
    at 120), and nothing while the screen is static.
    """

    def __init__(self):
        super().__init__(daemon=True)
        self.fps = None
        self.focus = ""
        self.stamp = 0.0

    def run(self):
        while True:
            try:
                with open(STATS_PIPE) as f:
                    for line in f:
                        key, _, val = line.strip().partition("=")
                        if key == "fps":
                            fps = float(val)
                            # gamescope occasionally reports absurd rates (near-zero
                            # frame intervals); no panel here goes past 240 Hz.
                            if 0 <= fps <= MAX_FPS:
                                self.fps = fps
                                self.stamp = time.monotonic()
                        elif key == "focus":
                            self.focus = val
            except (OSError, ValueError):
                pass
            time.sleep(1)


class GpuBusy:
    """GPU utilisation from DRM fdinfo (drm-engine-gpu busy ns per client)."""

    def __init__(self):
        self.fdinfos = []
        self.last_scan = 0.0
        self.prev = {}
        self.prev_t = None

    def scan(self):
        found = []
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            fd_dir = f"/proc/{pid}/fd"
            try:
                fds = os.listdir(fd_dir)
            except OSError:
                continue
            for fd in fds:
                try:
                    if os.readlink(f"{fd_dir}/{fd}").startswith("/dev/dri/"):
                        found.append(f"/proc/{pid}/fdinfo/{fd}")
                except OSError:
                    pass
        self.fdinfos = found
        self.last_scan = time.monotonic()

    def sample(self):
        now = time.monotonic()
        if now - self.last_scan > 3:
            self.scan()
        busy = {}
        for path in self.fdinfos:
            client = ns = None
            for line in read(path).splitlines():
                if line.startswith("drm-client-id:"):
                    client = line.split()[1]
                elif line.startswith("drm-engine-gpu:"):
                    ns = int(line.split()[1])
            if client is not None and ns is not None:
                busy[client] = ns
        pct = None
        if self.prev_t is not None:
            delta = sum(max(0, ns - self.prev.get(c, ns)) for c, ns in busy.items())
            pct = min(100.0, 100.0 * delta / ((now - self.prev_t) * 1e9))
        self.prev, self.prev_t = busy, now
        return pct


class Sampler:
    def __init__(self):
        self.fps = FpsReader()
        self.fps.start()
        self.gpu = GpuBusy()
        self.prev_stat = {}
        self.cpu_zones, self.gpu_zones = [], []
        for zone in glob.glob("/sys/class/thermal/thermal_zone*"):
            kind = read(f"{zone}/type")
            if kind.startswith("cpu"):
                self.cpu_zones.append(f"{zone}/temp")
            elif kind.startswith("gpuss"):
                self.gpu_zones.append(f"{zone}/temp")
        self.fan = next(iter(glob.glob("/sys/class/hwmon/*/fan1_input")), None)

    def cpu(self):
        per = {}
        for line in read("/proc/stat").splitlines():
            if not line.startswith("cpu") or line.startswith("cpu "):
                continue
            parts = line.split()
            vals = list(map(int, parts[1:]))
            idle = vals[3] + vals[4]
            total = sum(vals[:8])
            cpu = int(parts[0][3:])
            p = self.prev_stat.get(cpu)
            self.prev_stat[cpu] = (idle, total)
            if p and total > p[1]:
                per[cpu] = 100.0 * (1 - (idle - p[0]) / (total - p[1]))
        return per

    def sample(self):
        s = {}
        per = self.cpu()
        s["cpu"] = sum(per.values()) / len(per) if per else None
        s["gpu"] = self.gpu.sample()
        if GPU_DEVFREQ:
            s["gpu_mhz"] = read_int(f"{GPU_DEVFREQ}/cur_freq") // 1_000_000
        bat = uevent(BATTERY)
        usb = uevent(USB)
        s["bat_pct"] = int(bat.get("CAPACITY", 0))
        s["bat_status"] = bat.get("STATUS", "")
        # POWER_NOW on the Thor's battmgr is stale/garbage (~43 W at a real ~9 W); use V×I.
        s["bat_w"] = abs(int(bat.get("VOLTAGE_NOW", 0)) * int(bat.get("CURRENT_NOW", 0))) / 1e12
        s["usb_w"] = (int(usb.get("VOLTAGE_NOW", 0)) * int(usb.get("CURRENT_NOW", 0)) / 1e12
                      if usb.get("ONLINE") == "1" else 0.0)
        cur = abs(int(bat.get("CURRENT_NOW", 0)))
        now = int(bat.get("CHARGE_NOW", 0))
        full = int(bat.get("CHARGE_FULL", 0))
        s["bat_eta"] = None
        if cur > 50_000:
            if s["bat_status"] == "Discharging":
                s["bat_eta"] = now / cur
            elif s["bat_status"] == "Charging" and full > now:
                s["bat_eta"] = (full - now) / cur
        s["cpu_temp"] = max((read_int(z) for z in self.cpu_zones), default=0) / 1000
        s["gpu_temp"] = max((read_int(z) for z in self.gpu_zones), default=0) / 1000
        s["bat_temp"] = int(bat.get("TEMP", 0)) / 10
        s["fan_rpm"] = read_int(self.fan) if self.fan else None
        mem = {}
        for line in read("/proc/meminfo").splitlines():
            k, _, v = line.partition(":")
            mem[k] = int(v.split()[0])
        s["mem_used"] = (mem["MemTotal"] - mem["MemAvailable"]) / 1048576
        s["mem_total"] = mem["MemTotal"] / 1048576
        return s


# ---------------------------------------------------------------- drawing

def rgb(cr, c, a=1.0):
    cr.set_source_rgba(c[0], c[1], c[2], a)


def text(cr, widget, s, x, y, size, color, weight=Pango.Weight.BOLD, align="center", anchor="middle",
         max_width=None):
    layout = PangoCairo.create_layout(cr)
    desc = Pango.FontDescription.from_string("Noto Sans")
    desc.set_weight(weight)
    desc.set_absolute_size(size * Pango.SCALE)
    layout.set_font_description(desc)
    attrs = Pango.AttrList()
    attrs.insert(Pango.attr_font_features_new("tnum"))
    layout.set_attributes(attrs)
    layout.set_text(s, -1)
    if max_width:
        layout.set_width(int(max_width * Pango.SCALE))
        layout.set_ellipsize(Pango.EllipsizeMode.END)
    _, ext = layout.get_pixel_extents()
    w, h = ext.width, ext.height
    dx = {"center": -w / 2 - ext.x, "left": -ext.x, "right": -w - ext.x}[align]
    dy = {"middle": -h / 2 - ext.y, "top": -ext.y, "bottom": -h - ext.y}[anchor]
    rgb(cr, color)
    cr.move_to(x + dx, y + dy)
    PangoCairo.show_layout(cr, layout)
    return w


class Gauge(Gtk.DrawingArea):
    """270° arc meter with a big centre value and a small caption."""

    def __init__(self, label, color, maximum, minimum=0):
        super().__init__(hexpand=True, vexpand=True)
        self.label, self.color, self.minimum, self.maximum = label, color, minimum, maximum
        self.value, self.display, self.sub, self.arc_color = None, "–", "", color
        self.value_color = TEXT
        self.set_draw_func(self.draw)

    def update(self, value, display, sub="", color=None, value_color=None):
        self.value, self.display, self.sub = value, display, sub
        self.arc_color = color or self.color
        self.value_color = value_color or TEXT
        self.queue_draw()

    def draw(self, _area, cr, w, h):
        r = min(w, h * 1.12) / 2 - 6
        cx, cy = w / 2, h / 2 + r * 0.08
        lw = max(4.0, r * 0.13)
        start, sweep = math.radians(135), math.radians(270)
        cr.set_line_cap(1)
        cr.set_line_width(lw)
        rgb(cr, TRACK)
        cr.arc(cx, cy, r - lw / 2, start, start + sweep)
        cr.stroke()
        if self.value is not None:
            frac = max(0.0, min(1.0, (self.value - self.minimum) / (self.maximum - self.minimum)))
            if frac > 0.005:
                rgb(cr, self.arc_color)
                cr.arc(cx, cy, r - lw / 2, start, start + sweep * frac)
                cr.stroke()
        text(cr, self, self.display, cx, cy - r * 0.04, r * 0.48, self.value_color)
        text(cr, self, self.label, cx, cy + r * 0.42, r * 0.19, DIM)
        if self.sub:
            text(cr, self, self.sub, cx, cy + r * 0.82, r * 0.18, DIM, Pango.Weight.NORMAL)


class FpsPanel(Gtk.DrawingArea):
    """FPS readout, focused game, battery, and a scrolling FPS history graph."""

    def __init__(self):
        super().__init__(hexpand=True, vexpand=True)
        self.history = collections.deque(maxlen=120)
        self.fps, self.focus = None, ""
        self.battery, self.battery_sub, self.battery_color = "", "", TEXT
        self.max_hz = display_max_hz()
        self.set_draw_func(self.draw)

    def push(self, fps, focus):
        self.fps, self.focus = fps, focus
        self.history.append(fps if fps is not None else 0.0)
        self.queue_draw()

    def draw(self, _area, cr, w, h):
        pad = 10
        top = max(30, max(self.history, default=60) * 1.15)
        top = min(self.max_hz, 30 * math.ceil(top / 30))
        gx, gw = pad, w - 2 * pad
        big = min(h * 0.34, 44)
        gy = pad + big * 1.4 + 6  # graph starts below the readout's line box
        gh = h - gy - pad
        # Reference lines every 30 fps; label every 60 (or 30 on a short scale),
        # on the left.
        cr.set_line_width(1)
        label_step = 30 if top <= 60 else 60
        for ref in range(30, int(top) + 1, 30):
            y = gy + gh - gh * ref / top
            rgb(cr, TRACK, 0.7)
            cr.move_to(gx, y)
            cr.line_to(gx + gw, y)
            cr.stroke()
            if ref % label_step == 0:
                text(cr, self, str(ref), gx, y - 2, 10, DIM, Pango.Weight.NORMAL, "left", "bottom")
        pts = list(self.history)
        if len(pts) > 1:
            step = gw / (self.history.maxlen - 1)
            x0 = gx + gw - step * (len(pts) - 1)
            cr.move_to(x0, gy + gh)
            for i, v in enumerate(pts):
                cr.line_to(x0 + i * step, gy + gh - gh * min(v, top) / top)
            cr.line_to(x0 + (len(pts) - 1) * step, gy + gh)
            cr.close_path()
            rgb(cr, NEUTRAL, 0.08)
            cr.fill()
            for i, v in enumerate(pts):
                (cr.move_to if i == 0 else cr.line_to)(x0 + i * step, gy + gh - gh * min(v, top) / top)
            rgb(cr, NEUTRAL)
            cr.set_line_width(1.5)
            cr.stroke()
        shown = f"{self.fps:.0f}" if self.fps is not None else "idle"
        uw = text(cr, self, "FPS", w - pad, pad + big * 0.9, big * 0.36, DIM, align="right", anchor="bottom")
        text(cr, self, shown, w - pad - uw - 6, pad, big, TEXT if self.fps is not None else DIM,
             align="right", anchor="top")
        mid = pad + big * 0.6
        if self.focus:
            text(cr, self, app_name(self.focus), w / 2, mid, big * 0.36, TEXT,
                 Pango.Weight.NORMAL, "center", "middle", max_width=w * 0.45)
        if self.battery:
            bw = text(cr, self, self.battery, pad, mid, big * 0.5, self.battery_color,
                      align="left", anchor="middle")
            text(cr, self, self.battery_sub, pad + bw + 8, mid, big * 0.3, DIM,
                 Pango.Weight.NORMAL, "left", "middle")


