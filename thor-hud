class Power:
    """org.armada.Power proxy (profile, governor, GPU level/clock)."""

    IFACE = "org.armada.Power1"

    def __init__(self, on_change):
        self.proxy = None
        try:
            self.proxy = Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
                "org.armada.Power", "/org/armada/Power", self.IFACE, None)
            self.proxy.connect("g-properties-changed", lambda *_: on_change())
        except GLib.Error as e:
            print("thor-hud: power service unavailable:", e.message, file=sys.stderr)

    def get(self, name, default=None):
        if not self.proxy:
            return default
        v = self.proxy.get_cached_property(name)
        return v.unpack() if v is not None else default

    def set(self, name, variant):
        if not self.proxy:
            return
        self.proxy.call(
            "org.freedesktop.DBus.Properties.Set",
            GLib.Variant("(ssv)", (self.IFACE, name, variant)),
            Gio.DBusCallFlags.NONE, 3000, None, self._done, name)

    def _done(self, proxy, result, name):
        try:
            proxy.call_finish(result)
        except GLib.Error as e:
            print(f"thor-hud: set {name} failed:", e.message, file=sys.stderr)


class Segmented(Gtk.Box):
    def __init__(self, options, on_pick, css):
        super().__init__(homogeneous=True, css_classes=["seg", css])
        self.buttons = {}
        self.on_pick = on_pick
        self.syncing = False
        group = None
        for value, label in options:
            b = Gtk.ToggleButton(label=label, hexpand=True)
            if group:
                b.set_group(group)
            group = group or b
            b.connect("toggled", self.toggled, value)
            self.append(b)
            self.buttons[value] = b

    def toggled(self, button, value):
        if button.get_active() and not self.syncing:
            self.on_pick(value)

    def select(self, value):
        self.syncing = True
        for v, b in self.buttons.items():
            b.set_active(v == value)
        self.syncing = False


class Hud(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Thor HUD")
        self.sampler = Sampler()
        self.power = Power(lambda: GLib.idle_add(self.sync_knobs))

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                       margin_top=8, margin_bottom=8, margin_start=8, margin_end=8,
                       css_classes=["root"])
        self.set_child(root)

        self.fps = FpsPanel()
        self.fps.set_size_request(-1, 120)
        root.append(self.card(self.fps, vexpand=True))

        gauges = Gtk.Box(spacing=8, homogeneous=True)
        self.g_cpu = Gauge("CPU", CPU_C, 100)
        self.g_gpu = Gauge("GPU", GPU_C, 100)
        self.g_pwr = Gauge("WATTS", NEUTRAL, 15)
        self.g_tmp = Gauge("°C", TEMP_SCALE[0][1], 95, minimum=45)
        self.g_ram = Gauge("RAM", NEUTRAL, 100)
        for g in (self.g_cpu, self.g_gpu, self.g_ram, self.g_pwr, self.g_tmp):
            g.set_size_request(-1, 112)
            gauges.append(self.card(g))
        root.append(gauges)

        knobs = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, css_classes=["card"])
        root.append(knobs)

        profiles = self.power.get("AvailableProfiles", ["Eco", "Balanced", "Performance"])
        self.k_profile = Segmented([(p, p) for p in profiles],
                                   lambda v: self.power.set("Profile", GLib.Variant("s", v)), "profile")
        self.k_gpu = Segmented([("auto", "Auto"), ("max", "Max GPU")], self.pick_gpu, "gpu")
        self.governor_timer = None
        self.syncing = False

        knobs.append(self.k_profile)
        knobs.append(self.k_gpu)

        self.sync_knobs()
        self.tick()
        GLib.timeout_add(500, self.fast_tick)
        GLib.timeout_add(1000, self.tick)

    def card(self, child, vexpand=False):
        frame = Gtk.Box(css_classes=["card"], vexpand=vexpand)
        frame.append(child)
        return frame

    # -- knobs
    def sync_knobs(self):
        self.syncing = True
        self.k_profile.select(self.power.get("Profile"))
        self.enforce_governor()
        if self.power.get("GpuPerformanceLevel", "auto") == "auto":
            self.k_gpu.select("auto")
        elif self.power.get("ManualGpuClock") == self.power.get("ManualGpuClockMax"):
            self.k_gpu.select("max")
        else:
            self.k_gpu.select(None)  # pinned to some other clock elsewhere
        self.syncing = False
        return False

    def enforce_governor(self):
        # Debounced: powerd sets its own governor right after a profile change.
        if self.governor_timer:
            GLib.source_remove(self.governor_timer)

        def apply():
            self.governor_timer = None
            want = PROFILE_GOVERNOR.get(self.power.get("Profile"))
            if want and want != self.power.get("CpuScalingGovernor") \
                    and want in self.power.get("AvailableCpuScalingGovernors", [want]):
                self.power.set("CpuScalingGovernor", GLib.Variant("s", want))
            return False
        self.governor_timer = GLib.timeout_add(400, apply)

    def pick_gpu(self, mode):
        # "Max" pins the GPU at its top clock via the manual performance level.
        if mode == "max":
            self.power.set("ManualGpuClock", GLib.Variant("u", self.power.get("ManualGpuClockMax", 0)))
            self.power.set("GpuPerformanceLevel", GLib.Variant("s", "manual"))
        else:
            self.power.set("GpuPerformanceLevel", GLib.Variant("s", "auto"))

    # -- metrics
    def fast_tick(self):
        r = self.sampler.fps
        # Hold a reading until about 1.5 reporting intervals have passed.
        fresh = r.fps is not None and time.monotonic() - r.stamp < max(3, 450 / max(r.fps, 1))
        self.fps.push(r.fps if fresh else None, r.focus)
        return True

    def tick(self):
        s = self.sampler.sample()
        if s["cpu"] is not None:
            self.g_cpu.update(s["cpu"], f"{s['cpu']:.0f}%")
        gpu_sub = f"{s.get('gpu_mhz', 0)} MHz"
        if s["gpu"] is not None:
            self.g_gpu.update(s["gpu"], f"{s['gpu']:.0f}%", gpu_sub)
        charging = s["bat_status"] in ("Charging", "Full") or s["usb_w"] > 0.5
        if charging:
            self.g_pwr.update(s["usb_w"], f"{s['usb_w']:.1f}", "from USB", NEUTRAL)
        else:
            pc = heat_color(s["bat_w"], POWER_SCALE)
            self.g_pwr.update(s["bat_w"], f"{s['bat_w']:.1f}", "draw", pc,
                              pc if s["bat_w"] >= POWER_SCALE[2][0] else None)
        hot = max(s["cpu_temp"], s["gpu_temp"])
        fan = f"fan {s['fan_rpm']}" if s["fan_rpm"] is not None else f"bat {s['bat_temp']:.0f}°"
        tc = heat_color(hot, TEMP_SCALE)
        self.g_tmp.update(hot, f"{hot:.0f}", fan, tc, tc if hot >= TEMP_SCALE[2][0] else None)
        eta = ""
        if s["bat_eta"] is not None:
            hours = s["bat_eta"]
            eta = f"{int(hours)}h{int(hours * 60) % 60:02d}" + (" to full" if charging else " left")
        elif charging:
            eta = "charging"
        low = None if charging else BAD if s["bat_pct"] <= 10 else WARN if s["bat_pct"] <= 20 else None
        self.fps.battery, self.fps.battery_sub = f"{s['bat_pct']}%", eta
        self.fps.battery_color = low or TEXT
        ram = 100 * s["mem_used"] / s["mem_total"]
        self.g_ram.update(ram, f"{ram:.0f}%", f"{s['mem_used']:.1f} of {s['mem_total']:.0f}G")
        return True


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.thor.Hud", flags=Gio.ApplicationFlags.NON_UNIQUE)

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        settings = Gtk.Settings.get_default()
        settings.set_property("gtk-application-prefer-dark-theme", True)
        win = Hud(self)
        if "--windowed" in sys.argv:
            win.set_default_size(620, 540)
        else:
            win.fullscreen()
        win.present()
        if "--snapshot" in sys.argv:
            GLib.timeout_add(8000, lambda: GLib.timeout_add(500, self.snapshot, win) and False)

    def snapshot(self, win):
        paintable = Gtk.WidgetPaintable.new(win)
        w, h = win.get_width(), win.get_height()
        snap = Gtk.Snapshot()
        paintable.snapshot(snap, w, h)
        node = snap.to_node()
        if node is None:  # not drawn yet (e.g. not mapped); try again shortly
            return True
        renderer = win.get_native().get_renderer()
        tex = renderer.render_texture(node, None)
        tex.save_to_png(sys.argv[sys.argv.index("--snapshot") + 1])
        print(f"snapshot {w}x{h}")
        self.quit()
        return False


if __name__ == "__main__":
    sys.exit(App().run([sys.argv[0]]))
